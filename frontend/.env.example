VITE_API_BASE_URL=http://localhost:8000/api/v1

# InterviewProbe is voice-first via Deepgram (STT) and Azure Speech (TTS)
# only — there is no browser Web Speech API fallback. Both variables below
# are required and must be exactly "remote"; the app fails fast at startup
# with any other value rather than silently degrading to a different speech
# engine. Neither is ever a credential — both are application-level
# switches only. This app's own backend calls Azure Speech (TTS) and issues
# short-lived Deepgram tokens (STT); no Azure or Deepgram credential ever
# belongs in a VITE_* variable or the built frontend bundle.
VITE_TTS_MODE=remote
VITE_STT_MODE=remote
