VITE_API_BASE_URL=http://localhost:8000/api/v1

# Task 40: which TTS implementation the voice room uses. "browser" (the
# default) uses the Web Speech API directly; "remote" calls this app's own
# backend, which synthesizes speech via Azure Speech. This is an
# application-level switch only — never an Azure credential, which must
# never be present in a VITE_* variable or the built frontend bundle.
# VITE_TTS_MODE=remote

# Task 41: which STT implementation the voice room uses. "browser" (the
# default) uses the Web Speech API directly; "remote" streams the
# microphone straight to Deepgram, authorized by a short-lived token this
# app's own backend issues. This is an application-level switch only —
# never a Deepgram credential, which must never be present in a VITE_*
# variable or the built frontend bundle.
# VITE_STT_MODE=remote
