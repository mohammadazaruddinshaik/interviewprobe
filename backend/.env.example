APP_NAME="AI Engineering Interview Platform"
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_interview
REDIS_URL=redis://localhost:6379/0
REDIS_INTERVIEW_STATE_TTL_SECONDS=86400
REDIS_INTERVIEW_LOCK_TTL_SECONDS=30
REDIS_INTERVIEW_RATE_LIMIT=10
REDIS_INTERVIEW_RATE_WINDOW_SECONDS=60
REDIS_IDEMPOTENCY_TTL_SECONDS=86400

# LLM_PROVIDER selects the backend: "openai" or "gemini". LLM_API_KEY is
# used for whichever provider is selected. Leave it blank to run the app
# without LLM access — /health and the rest of the API work fine; only
# an actual call to the (not-yet-wired-in) LLM provider would fail.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Knowledge/RAG foundation (Task 19). Qdrant connectivity is lazy — the app
# starts fine without a reachable Qdrant, same as LLM_API_KEY above.
# EMBEDDING_API_KEY defaults to LLM_API_KEY when left blank.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=interview_knowledge
QDRANT_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
