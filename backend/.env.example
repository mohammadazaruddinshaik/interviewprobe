APP_NAME="AI Engineering Interview Platform"
ENVIRONMENT=development

# Task 48: the level app.* loggers emit at (see app/core/logging_config.py).
# One of DEBUG/INFO/WARNING/ERROR/CRITICAL, case-insensitive — an
# unrecognized value falls back to INFO rather than failing startup.
# INFO surfaces normal operational lifecycle events (LLM/TTS/STT call
# timing and status, knowledge-retrieval activity, Redis degradation
# warnings) through Render's stdout/stderr capture; third-party library
# loggers are left at their own default (WARNING) so this doesn't flood
# production logs with unrelated request-level noise.
LOG_LEVEL=INFO

# Task 50: bounds each individual dependency check inside GET /ready
# (database, Redis) — see app/core/readiness.py. A dependency that's
# genuinely hung (not just erroring) can't hold that endpoint's response
# past this many seconds.
READINESS_TIMEOUT_SECONDS=3

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_interview
REDIS_URL=redis://localhost:6379/0
REDIS_INTERVIEW_STATE_TTL_SECONDS=86400
REDIS_INTERVIEW_LOCK_TTL_SECONDS=30
REDIS_INTERVIEW_RATE_LIMIT=10
REDIS_INTERVIEW_RATE_WINDOW_SECONDS=60
REDIS_IDEMPOTENCY_TTL_SECONDS=86400

# Task 46: per-client (IP-based) abuse protection for the four endpoints
# reachable with no existing interview session to scope a rate limit by —
# this app has no authentication, so these are the only protection
# against unbounded paid-API usage (LLM calls via interview creation/
# start, Azure TTS, Deepgram token issuance). See app/api/deps.py.
INTERVIEW_CREATION_RATE_LIMIT=10
INTERVIEW_CREATION_RATE_WINDOW_SECONDS=60
INTERVIEW_START_RATE_LIMIT=5
INTERVIEW_START_RATE_WINDOW_SECONDS=60
VOICE_TTS_RATE_LIMIT=30
VOICE_TTS_RATE_WINDOW_SECONDS=60
VOICE_STT_TOKEN_RATE_LIMIT=10
VOICE_STT_TOKEN_RATE_WINDOW_SECONDS=60

# Task 25A: browser origins allowed to call this API via CORS, as a JSON
# array. Defaults to the local Vite dev server only (see core/config.py) —
# a deployed frontend origin (e.g. the production Vercel URL) must be set
# explicitly here, or that frontend will be CORS-rejected on every request.
# CORS_ALLOWED_ORIGINS=["https://interviewprobe.vercel.app"]

# LLM_PROVIDER selects the backend: "openai" or "gemini". LLM_API_KEY is
# used for whichever provider is selected. Leave it blank to run the app
# without LLM access — /health and the rest of the API work fine; only
# an actual call to the (not-yet-wired-in) LLM provider would fail.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Knowledge/RAG foundation (Task 19). Qdrant connectivity is lazy — the app
# starts fine without a reachable Qdrant, same as LLM_API_KEY above.
# EMBEDDING_API_KEY defaults to LLM_API_KEY when left blank.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=interview_knowledge
QDRANT_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
# Task 49: shorter than LLM_TIMEOUT_SECONDS (30) deliberately — a single
# embedding call is a much simpler/faster operation than a chat
# completion. A stalled embedding request past this bound raises a
# dedicated EmbeddingTimeoutError, caught at the same KnowledgeError
# boundary as any other retrieval failure — question generation degrades
# to ungrounded, it never fails the turn.
EMBEDDING_TIMEOUT_SECONDS=10

# Task 20: how many knowledge chunks a single graph turn retrieves from
# Qdrant. Bounds how much retrieved context reaches the LLM prompt.
KNOWLEDGE_RETRIEVAL_LIMIT=5

# Task 40: Azure Speech TTS. Backend-only — never exposed to the frontend.
# Leave blank to run the app without voice access; /health and every other
# endpoint work fine. Only a call to POST /api/v1/voice/tts would fail,
# with a clear VOICE_SERVICE_MISCONFIGURED error, until these are set.
TTS_PROVIDER=azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=en-IN-PrabhatNeural
TTS_TIMEOUT_SECONDS=15

# Task 41: Deepgram streaming STT. The backend only exchanges this
# permanent key for a short-lived browser token (POST /api/v1/voice/stt/
# token) via Deepgram's /v1/auth/grant endpoint — it never proxies audio.
# Leave blank to run the app without voice input; only that one endpoint
# would fail, with a clear VOICE_SERVICE_MISCONFIGURED error.
STT_AUTH_PROVIDER=deepgram
DEEPGRAM_API_KEY=
STT_AUTH_TIMEOUT_SECONDS=10
