# Backend API base URL. Must INCLUDE the /api/v1 prefix (the client appends paths like /dashboard to it).
# The page's origin (e.g. http://localhost:5173) must be listed in the backend's CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=https://interviewprobe.onrender.com/api/v1

# Google OAuth Web client ID used by Google Identity Services on /signin (public, not a secret).
# Must be the same client ID the backend has in GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=
